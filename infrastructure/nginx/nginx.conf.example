# Sketch for a future production setup. NOT used by docker-compose.yml.
#
# Client addresses (rate limits are keyed by them): nginx is the only hop that talks to
# uvicorn, and it OVERWRITES X-Forwarded-For with the real client address. uvicorn runs with
# `--proxy-headers` and trusts X-Forwarded-For only from FORWARDED_ALLOW_IPS = nginx's address
# as seen by the backend (e.g. the nginx container IP or Docker network CIDR). Never "*".

# Behind Cloudflare: restore the visitor address from CF-Connecting-IP, but only for requests
# that really come from Cloudflare. Keep this list in sync with https://www.cloudflare.com/ips/
# (one set_real_ip_from line per published range). Without Cloudflare, delete this block.
# set_real_ip_from 173.245.48.0/20;
# set_real_ip_from 103.21.244.0/22;
# ...
# real_ip_header CF-Connecting-IP;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;   # built frontend (frontend/dist)
    index index.html;

    # Uploads are capped at 5 MB by the API; leave room for the multipart envelope.
    client_max_body_size 6m;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        # $remote_addr (after real_ip above), NOT $proxy_add_x_forwarded_for: a client-sent
        # X-Forwarded-For must never reach uvicorn, or guests could pick their own rate-limit key.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
