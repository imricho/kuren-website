# Copy this file to `.env` and adjust values. Never commit `.env`.
#   cp .env.example .env

# --- General -----------------------------------------------------------------
# development | test | production
ENVIRONMENT=development

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=wedding
# Use a long random value, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wedding
# Port published on 127.0.0.1 of the host (change if 5432 is already in use)
POSTGRES_HOST_PORT=5432

# --- Backend ------------------------------------------------------------------
BACKEND_HOST_PORT=8000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Session lifetime in hours (default: 7 days)
SESSION_TTL_HOURS=168
# Set to true when served over HTTPS (production)
# Must be true in production (the backend refuses to start otherwise).
SESSION_COOKIE_SECURE=false
# Proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs; never '*').
# Behind nginx/Cloudflare set this to the proxy's address so rate limits see real guests.
FORWARDED_ALLOW_IPS=127.0.0.1
# Run `alembic upgrade head` on container start (set false when migrating as a one-off job)
RUN_MIGRATIONS=true
# Rate-limit store: "memory" (per process, fine for one dev worker) or "database"
# (shared by every worker/replica). ENVIRONMENT=production refuses to start without "database".
RATE_LIMIT_BACKEND=memory
# Rate limits per minute
PUBLIC_RATE_LIMIT_PER_MINUTE=120
RSVP_RATE_LIMIT_PER_MINUTE=10
RSVP_SLUG_RATE_LIMIT_PER_MINUTE=300
# Max RSVP request body in bytes
MAX_RSVP_BODY_BYTES=16384
# Max uploaded images per invitation (renamed from MAX_ASSETS_PER_WEDDING, which is no longer read)
MAX_ASSETS_PER_INVITATION=300

# --- Frontend -----------------------------------------------------------------
FRONTEND_HOST_PORT=5173
